# Copia este archivo a .env y ajusta los valores. .env NO se versiona.
# Referencia completa y requisitos de producción: docs/PRODUCTION.md
# Genera secretos con: openssl rand -hex 48   (la API rechaza valores de ejemplo o débiles)

# --- Entorno ---
# development | test | production. En production la API exige REDIS_URL, ESCROW_CONTRACT_ID,
# PUBLIC_ORIGIN https://, VERIFY_STELLAR_TX=true y rechaza contraseñas de ejemplo.
# NODE_ENV=development
# LOG_LEVEL=info              # fatal | error | warn | info | debug | trace | silent

# --- PostgreSQL ---
# Opción A: una URL de conexión (tiene prioridad). Añade ?sslmode=require si la BD es remota.
DATABASE_URL=postgres://luminary:CHANGE_ME@127.0.0.1:5432/luminary
# Opción B: variables estándar de libpq (se usan si DATABASE_URL está vacía)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=luminary
# PGPASSWORD=CHANGE_ME
# PGDATABASE=luminary
# Pool: conexiones por proceso y timeouts (ms)
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000

# --- Redis ---
# Rate limit de login/registro y revocación de tokens compartidos entre procesos.
# Vacío → memoria del proceso (solo desarrollo; se avisa al arrancar).
# Si está definido y Redis cae, login/registro y rutas autenticadas responden 503 (fail-closed).
REDIS_URL=redis://127.0.0.1:6379

# --- API ---
# Obligatorio. El valor de abajo es INVÁLIDO a propósito (la API no arranca con él): sustitúyelo.
JWT_SECRET=CHANGE_ME
HOST=127.0.0.1
PORT=4000
# URL pública de la SPA (obligatoria en producción, https://). Se usa en la política de origen.
# PUBLIC_ORIGIN=https://luminary.example.com
# Orígenes extra autorizados (CORS con credenciales), separados por comas. Normalmente vacío.
# CORS_ORIGINS=
# Proxies de confianza para la IP real del cliente (rate limit por IP): false | número de saltos
# (1 = un proxy inverso) | IPs/CIDR | loopback | linklocal | uniquelocal. 'true' no se acepta.
# Por defecto: loopback en desarrollo, false (no confiar en X-Forwarded-For) en producción.
# El proxy DEBE sobrescribir X-Forwarded-For (no añadir al del cliente). Ver docs/PRODUCTION.md.
# TRUST_PROXY=1
# Trades tomados pero nunca fondeados se cancelan solos tras N minutos (0 = nunca) y su USDC
# vuelve a la oferta. El barrido corre cada TRADE_EXPIRY_INTERVAL_SECONDS en cada proceso.
# PENDING_TRADE_TTL_MINUTES=30
# TRADE_EXPIRY_INTERVAL_SECONDS=60
# BODY_LIMIT=20kb
# SHUTDOWN_TIMEOUT_MS=10000
# Sirve la SPA compilada (dist/) desde la API. Vacío = solo API (la imagen Docker lo activa).
# STATIC_DIR=dist
# Orígenes extra para connect-src de la CSP (si la SPA usa Horizon/RPC propios).
# CSP_CONNECT_SRC=

# --- Stellar / escrow on-chain ---
# Contrato luminary-escrow (contract-luminary/contracts/escrow). Despliegue de testnet:
ESCROW_CONTRACT_ID=CA77HZ3YHCNKXG6M2OZKN7QAI7UDEEOX2AHDEQU5LO4DTD7QHI6K6BOI
# Verifica cada paso del escrow (depósito, liberación, reembolso) vía Soroban RPC (true por defecto).
# false SOLO para pruebas locales sin red (npm run test:smoke usa hashes ficticios); prohibido en production.
VERIFY_STELLAR_TX=true
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Token del escrow: por defecto el SAC del USDC de Circle en testnet (derivado de USDC_ISSUER).
# En mainnet USDC_ISSUER y SOROBAN_RPC_URL son obligatorias.
# USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# ESCROW_TOKEN_ID=C...   # otro SAC (p.ej. un token de prueba)

# --- Docker Compose (docker-compose.yml) ---
# Usa valores hex (openssl rand -hex 24): van dentro de URLs de conexión.
# POSTGRES_USER=luminary
# POSTGRES_PASSWORD=
# POSTGRES_DB=luminary
# REDIS_PASSWORD=
# API_PORT=8080               # publicado solo en 127.0.0.1
# LUMINARY_TAG=local

# --- Frontend (Vite) ---
# Variables de build públicas: ver .env.production.example
# VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
