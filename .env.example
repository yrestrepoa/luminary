# Copia este archivo a .env y ajusta los valores. .env NO se versiona.

# --- PostgreSQL ---
# Opción A: una URL de conexión (tiene prioridad)
DATABASE_URL=postgres://luminary:change-me@127.0.0.1:5432/luminary
# Opción B: variables estándar de libpq (se usan si DATABASE_URL está vacía)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=luminary
# PGPASSWORD=change-me
# PGDATABASE=luminary

# --- Redis ---
# Rate limit de login/registro y revocación de tokens compartidos entre procesos.
# Vacío → memoria del proceso (solo desarrollo; se avisa al arrancar).
# Si está definido y Redis cae, login/registro y rutas autenticadas responden 503 (fail-closed).
REDIS_URL=redis://127.0.0.1:6379

# --- API ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
HOST=127.0.0.1
PORT=4000
# NODE_ENV=production   # activa cookies Secure (requiere HTTPS)

# --- Stellar ---
# Verifica en Horizon el pago USDC al liberar un trade (true por defecto).
VERIFY_STELLAR_TX=true
# HORIZON_URL=https://horizon-testnet.stellar.org
