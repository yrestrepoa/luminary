# Variables de BUILD del frontend (Vite). Se incrustan en el JavaScript público:
# NUNCA pongas secretos aquí. Copia a .env.production (no versionado) o pásalas en el
# entorno de `npm run build` / `docker build --build-arg`.

# Red Stellar: testnet (por defecto) | mainnet.
VITE_STELLAR_NETWORK=testnet

# Base de la API. Por defecto "/api" en el mismo origen que la SPA (recomendado: la API sirve
# la SPA o un proxy las publica bajo el mismo dominio). Otro origen exige mismo "site" y
# añadirlo a CORS_ORIGINS en el servidor.
# VITE_API_BASE_URL=/api

# Endpoints Stellar. En mainnet VITE_SOROBAN_RPC_URL y VITE_USDC_ISSUER son OBLIGATORIAS.
# Si usas endpoints propios, añádelos también a CSP_CONNECT_SRC en el servidor.
# VITE_HORIZON_URL=https://horizon-testnet.stellar.org
# VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# VITE_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# VITE_EXPLORER_URL=https://stellar.expert/explorer/testnet
# VITE_FRIENDBOT_URL=https://friendbot.stellar.org   # solo testnet

# Sourcemaps en el build (false por defecto; no los publiques si contienen código privado).
# VITE_SOURCEMAP=false
